{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%@ closed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se cerró"
          }
        }
      }
    },
    "%@ is open: ⇄ switches to it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está abierto: ⇄ cambia a él"
          }
        }
      }
    },
    "%@ · linked": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · vinculado"
          }
        }
      }
    },
    "%@ · pair once to play": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · vincúlalo una vez para jugar"
          }
        }
      }
    },
    "%@ · player %lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · jugador %lld"
          }
        }
      }
    },
    "%@ · update this game to play with NX Pad": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · actualiza este juego para jugar con NX Pad"
          }
        }
      }
    },
    "%lld games open": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld juegos abiertos"
          }
        }
      }
    },
    "A floating stick starts where your thumb lands. Tap a stick to click it; tap it, then touch it again and hold to keep it clicked.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una palanca flotante empieza donde pones el pulgar. Toca una palanca para pulsarla; tócala y vuelve a tocarla manteniendo el dedo para dejarla pulsada."
          }
        }
      }
    },
    "A paired Mac's games show up and are joined as soon as they open. A Mac pairs once, with the code its game shows under Controllers > Pair iPhone….": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los juegos de un Mac vinculado aparecen y se conectan en cuanto se abren. Cada Mac se vincula una vez, con el código que muestra su juego en Controllers > Pair iPhone…."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca de"
          }
        }
      }
    },
    "Address (192.168.1.20 or mac.local:48620)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección (192.168.1.20 o mac.local:48620)"
          }
        }
      }
    },
    "Allow Local Network access for NX Pad in Settings to find games.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a la red local para NX Pad en Ajustes para encontrar juegos."
          }
        }
      }
    },
    "Back to games": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a los juegos"
          }
        }
      }
    },
